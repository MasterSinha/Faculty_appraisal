# .dockerignore - Files to exclude from Docker build context

# Documentation — all docs live in Docs/, one line covers everything
Docs/

# Dev / tooling
.git
.github
.claude
.venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache

# Admin UI — now hosted and built in its own repository pbas_admin
admin_ui/

# Infra / config not needed in image
tests/
scripts/
cloudbuild.yaml
CLAUDE.md
README.md
.env
.env.*
.env.example
.env.test
.python-version
output.txt

# Local uploads and database backups
uploads/
db_backup.sql
*.sql
*.zip
