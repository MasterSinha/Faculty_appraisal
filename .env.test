# ==============================================================================
# FACULTY APPRAISAL SYSTEM - TESTING ENVIRONMENT CONFIGURATION (.env.test)
# ==============================================================================

# --- 1. Database Configuration ---
# "db_test" is the name of the PostgreSQL container service in docker-compose.test.yml.
# Since it runs on the Docker network, we connect to host "db_test" on port 5432.
DATABASE_URL="postgresql+asyncpg://fac_user_test:test_db_password@db_test:5432/faculty_appraisal_test"

# --- 2. Security & Authentication ---
USE_LOCAL_AUTH="true"
# Generate a new random string for JWT key. Do not reuse the production key.
JWT_SECRET_KEY="test_jwt_secret_key_change_me_if_needed_for_security"
ALLOW_MOCK_USER="false"

# --- 3. System URLs ---
# The test server will be exposed on host port 8081
APP_URL="http://localhost:8081"
FRONTEND_URL="http://localhost:3000"

# --- 4. File Storage Configuration ---
# Use local file system storage for tests
USE_LOCAL_STORAGE="true"
# Within the container, files will be saved in /app/uploads, which is mapped
# to ./uploads_test on your host VM.
LOCAL_STORAGE_DIR="/app/uploads"
